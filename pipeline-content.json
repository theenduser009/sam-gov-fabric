{
  "properties": {
    "description": "Download public SAM.gov Award and IDV extracts to the notebook's default Fabric Lakehouse.",
    "parameters": {
      "signed_from": {
        "type": "String"
      },
      "signed_to": {
        "type": "String"
      }
    },
    "activities": [
      {
        "name": "Download SAM.gov Awards and IDVs",
        "type": "TridentNotebook",
        "dependsOn": [],
        "policy": {
          "timeout": "0.00:40:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureInput": true,
          "secureOutput": true
        },
        "typeProperties": {
          "notebookId": "<FABRIC_NOTEBOOK_ID>",
          "workspaceId": "<FABRIC_WORKSPACE_ID>",
          "parameters": {
            "signed_from": {
              "value": {
                "value": "@pipeline().parameters.signed_from",
                "type": "Expression"
              },
              "type": "string"
            },
            "signed_to": {
              "value": {
                "value": "@pipeline().parameters.signed_to",
                "type": "Expression"
              },
              "type": "string"
            }
          }
        }
      }
    ]
  }
}
